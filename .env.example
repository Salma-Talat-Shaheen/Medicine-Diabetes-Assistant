# Environment Configuration for Medicine Assistant
# Copy this file to .env and fill in your values

# OpenRouter API Key (required)
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
# Model to use (optional, defaults to openai/gpt-4o-mini)
# See available models at: https://openrouter.ai/models
MODEL_NAME=openai/gpt-4o-mini

OCR_PDF_PATH=scripts/hcea guidelines_BW 1-25-2021-4-7_page-0001.pdf
DATABASE_URL=your_postgresql_here

# RAG Configuration (optional)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# Vector Store Configuration (optional)
CHROMA_PERSIST_DIRECTORY=./chroma_db
COLLECTION_NAME=medicine_docs
ANONYMIZED_TELEMETRY=False
